# Survivors Game 배포 환경변수 템플릿
# 이 파일을 .env.deploy로 복사하고 값을 채워 사용하세요
# .env.deploy 자체는 .gitignore되어 커밋되지 않습니다
#
# 사용법:
#   cp .env.deploy.example .env.deploy
#   $EDITOR .env.deploy
#   chmod 600 .env.deploy
#   ./deploy.exp

# 배포 대상 서버 (SSH user@host)
DEPLOY_HOST=root@example.com

# SSH 개인키 절대 경로 (절대 git에 커밋 금지)
# 권장: ~/.ssh/ 디렉토리에 보관
DEPLOY_KEY=/Users/your-user/.ssh/survivors_deploy_key

# deploy.exp (정적 PWA 전용) 의 rsync 대상
REMOTE_DIR=/home/docker/games/survivors

# ─── deploy-stack.exp 용 (Phase 2 풀스택 배포) ───
# Contabo 의 repo clone 위치 — dist/, infra/, backend/, src/ 모두 포함
STACK_REMOTE_DIR=/home/docker/games/survivors

# (선택) 배포할 git 브랜치 (기본 main)
DEPLOY_BRANCH=main

# (선택) 배포 완료 후 헬스 체크 호출 — status:ok 아니면 exit 1
API_HEALTH_URL=https://games.blocktalker.co.kr/survivors/api/health

# (선택) 배포 완료 후 출력할 URL
LIVE_URL=https://games.blocktalker.co.kr/survivors/
