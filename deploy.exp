#!/bin/bash
set -e

HOST="root@REDACTED_IP"
KEY="/Users/hangup2/apps/survivors-game-project/.deploy_key"
LOCAL_DIR="/Users/hangup2/apps/survivors-game-project/dist/"
REMOTE_DIR="/home/docker/games/survivors"
SSH_OPTS="-i $KEY -o StrictHostKeyChecking=no"

echo "===> Building project..."
cd /Users/hangup2/apps/survivors-game-project
npm run build

echo "===> Cleaning remote directory: $REMOTE_DIR"
ssh $SSH_OPTS $HOST "mkdir -p $REMOTE_DIR && rm -rf $REMOTE_DIR/*"

echo "===> Deploying files using rsync from $LOCAL_DIR to $HOST:$REMOTE_DIR"
rsync -avz -e "ssh $SSH_OPTS" $LOCAL_DIR $HOST:$REMOTE_DIR/

echo "===> Deployment finished!"
echo "===> Live URL: https://games.blocktalker.co.kr/survivors/"
