#!/bin/bash
set -e

# Survivors Game 배포 스크립트
# 자격증명은 .env.deploy 파일에서 로드 (gitignore됨)
# 사용 전 .env.deploy.example을 .env.deploy로 복사하고 값 입력

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENV_FILE="$SCRIPT_DIR/.env.deploy"

if [ ! -f "$ENV_FILE" ]; then
    echo "Error: $ENV_FILE not found"
    echo "Copy .env.deploy.example to .env.deploy and fill in values."
    exit 1
fi

# 환경변수 로드
set -a
source "$ENV_FILE"
set +a

# 필수 변수 검증
: "${DEPLOY_HOST:?Need DEPLOY_HOST in .env.deploy (e.g. root@1.2.3.4)}"
: "${DEPLOY_KEY:?Need DEPLOY_KEY in .env.deploy (absolute path to SSH private key)}"
: "${REMOTE_DIR:?Need REMOTE_DIR in .env.deploy (e.g. /home/docker/games/survivors)}"

# SSH 키 권한 확인
if [ -f "$DEPLOY_KEY" ]; then
    PERMS=$(stat -f "%Lp" "$DEPLOY_KEY" 2>/dev/null || stat -c "%a" "$DEPLOY_KEY" 2>/dev/null)
    if [ "$PERMS" != "600" ] && [ "$PERMS" != "400" ]; then
        echo "Error: SSH key $DEPLOY_KEY has unsafe permissions ($PERMS). Run: chmod 600 $DEPLOY_KEY"
        exit 1
    fi
else
    echo "Error: SSH key not found: $DEPLOY_KEY"
    exit 1
fi

LOCAL_DIR="$SCRIPT_DIR/dist/"
SSH_OPTS="-i $DEPLOY_KEY -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=$SCRIPT_DIR/.ssh_known_hosts"

echo "===> Building project..."
cd "$SCRIPT_DIR"
npm run build

echo "===> Cleaning remote directory: $REMOTE_DIR"
ssh $SSH_OPTS "$DEPLOY_HOST" "mkdir -p $REMOTE_DIR && rm -rf $REMOTE_DIR/*"

echo "===> Deploying files from $LOCAL_DIR to $DEPLOY_HOST:$REMOTE_DIR"
rsync -avz -e "ssh $SSH_OPTS" "$LOCAL_DIR" "$DEPLOY_HOST:$REMOTE_DIR/"

echo "===> Deployment finished!"
if [ -n "$LIVE_URL" ]; then
    echo "===> Live URL: $LIVE_URL"
fi
