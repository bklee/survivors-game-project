# Survivors Game 인프라 환경변수
# 이 파일을 .env로 복사 후 값 채우기

POSTGRES_DB=survivors
POSTGRES_USER=survivors_app
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# Lemon Squeezy webhook signing secret (Phase 2)
LS_WEBHOOK_SECRET=your_secret_from_LS_dashboard

# API CORS allowed origins (콤마 구분 다중 origin 지원)
#   - 자체 PWA 도메인
#   - GameDistribution CDN 호스팅 origin (revision/html5)
CORS_ORIGIN=https://games.blocktalker.co.kr,https://revision.gamedistribution.com,https://html5.gamedistribution.com

# Admin dashboard Basic Auth (format: user:password)
# 운영자가 실제 시크릿으로 교체할 것
ADMIN_AUTH=admin:CHANGE_ME_STRONG_SECRET_HERE
